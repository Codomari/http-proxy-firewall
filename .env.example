# Copy this file to .env and supply deployment values yourself.
MAXMIND_LICENSE_KEY=
MAXMIND_DATABASE_PATH=files/geo.mmdb
LETSENCRYPT_EMAIL=
# Restrict automatic certificate issuance to your domains in production.
PF_TLS_HOSTS=
PF_TLS_ENABLED=true
PF_TLS_ALLOW_LEGACY=false
PF_TLS_CACHE_DIR=.cache
# Optional static TLS pair; leave both empty to use automatic certificates.
PF_TLS_CERT_FILE=
PF_TLS_KEY_FILE=
PF_LISTEN=0.0.0.0:80
PF_TLS_LISTEN=0.0.0.0:443
PF_PROXY_TO=http://127.0.0.1:8008
# Optional host routing; unmatched hosts use PF_PROXY_TO.
PF_UPSTREAM_ROUTES=
PF_IPV4_REDIRECT=https://hostinq.biz

IP_FILTER_WHITELIST=127.0.0.1,::1
IP_FILTER_WHITELIST_NETWORKS=
IP_FILTER_ALLOWED_COUNTRIES=Azerbaijan,Turkey
# Require the cookie checkpoint during DDoS penalties, even for whitelisted clients.
IP_FILTER_WHITELIST_CHECKPOINT=true
IP_FILTER_COUNTRIES_CHECKPOINT=true
# Only configured proxy peers may supply forwarding headers.
PF_TRUSTED_PROXIES=
PF_TRUST_CLOUDFLARE_HEADER=false
# Persistent per-host Behind Cloudflare switches managed in the admin panel.
PF_CLOUDFLARE_HOSTS_FILE=files/cloudflare-hosts.json
DOS_DETECTOR_HOSTNAME_REQUEST_THRESHOLD=200
DOS_DETECTOR_HOSTNAME_PENALTY_LIFETIME=10m
PF_COOKIE_LIFETIME=24h
PF_CACHE_CAPACITY=100000
CVE_MITIGATOR_MAX_BODY_BYTES=33554432
PF_MAX_BUFFERED_BYTES=268435456
CVE_MITIGATOR_UPLOAD_PROGRESS_NAMES=
# Sample rejection logs per reason at most once per interval; 0s logs every rejection.
PF_REJECTION_LOG_INTERVAL=1s

PF_MAX_CONNECTIONS=10000
PF_MAX_CONCURRENT_REQUESTS=256
PF_UPSTREAM_MAX_CONNECTIONS=256
PF_READ_TIMEOUT=10m
PF_WRITE_TIMEOUT=10m
PF_IDLE_TIMEOUT=1m
PF_UPSTREAM_READ_TIMEOUT=10m
PF_UPSTREAM_WRITE_TIMEOUT=10m
PF_UPSTREAM_IDLE_TIMEOUT=1m

PF_ENABLE_REDIS=false
REDIS_ADDRESS=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=250ms
REDIS_QUEUE_SIZE=1024
REDIS_WORKERS=4

PF_METRICS=false
# One user:password entry per line; the credentials file supports multiple accounts.
PF_ADMIN_CREDS_FILE=.creds
PF_ADMIN_URI=__pf/__admin
PF_ADMIN_MAX_HOSTS=10000
# Optional override: PF_ADMIN_ENABLED=false disables the admin interface.
PF_SILENT=true
# Empty disables profiling; keep a loopback address when enabled.
PF_PPROF_ADDRESS=127.0.0.1:8068
PF_INTELLIGENCE_REFRESH_INTERVAL=24h
PF_INTELLIGENCE_HTTP_TIMEOUT=30s
