[Unit]
Description=Layer 7 Proxy Firewall
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/etc/proxy-firewall
# The application merges default and override YAML from WorkingDirectory.
# make install replaces this fallback with max(1, floor(online CPUs * 2 / 5)).
ExecStart=/usr/bin/env GOMAXPROCS=1 /etc/proxy-firewall/bin/proxy-firewall
StandardOutput=append:/etc/proxy-firewall/log/proxy-firewall.log
StandardError=append:/etc/proxy-firewall/log/proxy-firewall.log
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Atomic override YAML saves require write access to its parent directory.
ReadWritePaths=/etc/proxy-firewall /etc/proxy-firewall/log /etc/proxy-firewall/files /etc/proxy-firewall/.cache /etc/proxy-firewall/.certs
ReadOnlyPaths=/etc/proxy-firewall/bin -/etc/proxy-firewall/.creds -/etc/proxy-firewall/proxy-firewall.default.yaml -/etc/proxy-firewall/LICENSE
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
