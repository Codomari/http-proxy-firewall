<body id="status-page" data-page="request-too-large" data-status="413" data-translations="{&#34;az&#34;:{&#34;restart_title&#34;:&#34;Server yenidən başladılır&#34;,&#34;reassurance&#34;:&#34;Narahat olmayın (:\nBir neçə saniyəyə geri qayıdacağıq&#34;,&#34;reconnecting&#34;:&#34;Avtomatik olaraq yenidən qoşulur…&#34;,&#34;ready&#34;:&#34;Server hazırdır. Səhifə açılır…&#34;,&#34;ready_playing&#34;:&#34;Server hazırdır! Oyuna davam edin və ya sayta qayıdın.&#34;,&#34;noscript&#34;:&#34;Avtomatik qoşulmaq üçün JavaScript-i aktivləşdirin və ya aşağıdakı keçiddən istifadə edin.&#34;,&#34;reload&#34;:&#34;Səhifəni yeniləyin&#34;,&#34;blocked_title&#34;:&#34;Domen qara siyahıdadır&#34;,&#34;blocked_message&#34;:&#34;Sorğu edilən domenin bu serverə yönləndirildiyinə əmin olun.&#34;,&#34;tls_hostname_title&#34;:&#34;Domen adı tələb olunur&#34;,&#34;tls_hostname_message&#34;:&#34;Domen adı olmadan təhlükəsiz sorğuya icazə verilmir.&#34;,&#34;body_limit_title&#34;:&#34;Sorğunun həcmi çox böyükdür&#34;,&#34;body_limit_message&#34;:&#34;Yüklədiyiniz faylların və ya formanın həcmi bu saytın icazə verdiyi həddi aşır. Maksimum ümumi həcm 200 MiB-dır. Daha kiçik fayllar seçin və ya eyni anda daha az fayl göndərib yenidən cəhd edin.&#34;,&#34;input_limit_message&#34;:&#34;Bu formada həddindən artıq çox sahə, fayl və ya iç-içə dəyər var. Daha az element göndərin və ya formanı sadələşdirib yenidən cəhd edin.&#34;,&#34;game_title&#34;:&#34;İks-sıfır&#34;,&#34;game_rules&#34;:&#34;12×12 · Üfüqi, şaquli və ya diaqonal üzrə beş işarə ilə qazanın.&#34;,&#34;restart_game&#34;:&#34;Yenidən başlayın&#34;,&#34;language_label&#34;:&#34;Dil&#34;,&#34;your_turn&#34;:&#34;Sizin növbəniz · X&#34;,&#34;computer_turn&#34;:&#34;Kompüterin növbəsi · O&#34;,&#34;win&#34;:&#34;Siz qalib gəldiniz!&#34;,&#34;lose&#34;:&#34;Kompüter qalib gəldi!&#34;,&#34;draw&#34;:&#34;Heç-heçə!&#34;,&#34;play_again&#34;:&#34;Yenidən oynayın&#34;,&#34;continue&#34;:&#34;Sayta qayıdın&#34;,&#34;cell_label&#34;:&#34;Sətir {row}, sütun {column}&#34;},&#34;de&#34;:{&#34;restart_title&#34;:&#34;Server wird neu gestartet&#34;,&#34;reassurance&#34;:&#34;Keine Sorge (:\nWir sind in wenigen Sekunden wieder da&#34;,&#34;reconnecting&#34;:&#34;Verbindung wird automatisch wiederhergestellt…&#34;,&#34;ready&#34;:&#34;Server ist bereit. Seite wird geöffnet…&#34;,&#34;ready_playing&#34;:&#34;Server ist bereit! Spielen Sie weiter oder kehren Sie zur Website zurück.&#34;,&#34;noscript&#34;:&#34;Aktivieren Sie JavaScript für die automatische Verbindung oder nutzen Sie den Link unten.&#34;,&#34;reload&#34;:&#34;Seite neu laden&#34;,&#34;blocked_title&#34;:&#34;Domain gesperrt&#34;,&#34;blocked_message&#34;:&#34;Stellen Sie sicher, dass die angeforderte Domain auf diesen Server verweist.&#34;,&#34;tls_hostname_title&#34;:&#34;Domainname erforderlich&#34;,&#34;tls_hostname_message&#34;:&#34;Eine sichere Anfrage ohne Domainnamen ist nicht erlaubt.&#34;,&#34;body_limit_title&#34;:&#34;Anfrage zu groß&#34;,&#34;body_limit_message&#34;:&#34;Ihre hochgeladenen Dateien oder das Formular überschreiten die für diese Website erlaubte Größe. Die maximale Gesamtgröße beträgt 200 MiB. Verwenden Sie kleinere Dateien oder senden Sie weniger Dateien auf einmal und versuchen Sie es erneut.&#34;,&#34;input_limit_message&#34;:&#34;Dieses Formular enthält zu viele Felder, Dateien oder verschachtelte Werte. Senden Sie weniger Elemente oder vereinfachen Sie das Formular und versuchen Sie es erneut.&#34;,&#34;game_title&#34;:&#34;Tic-Tac-Toe&#34;,&#34;game_rules&#34;:&#34;12×12 · Fünf waagerecht, senkrecht oder diagonal gewinnen.&#34;,&#34;restart_game&#34;:&#34;Neu beginnen&#34;,&#34;language_label&#34;:&#34;Sprache&#34;,&#34;your_turn&#34;:&#34;Sie sind dran · X&#34;,&#34;computer_turn&#34;:&#34;Computer ist dran · O&#34;,&#34;win&#34;:&#34;Sie haben gewonnen!&#34;,&#34;lose&#34;:&#34;Der Computer gewinnt!&#34;,&#34;draw&#34;:&#34;Unentschieden!&#34;,&#34;play_again&#34;:&#34;Erneut spielen&#34;,&#34;continue&#34;:&#34;Zur Website&#34;,&#34;cell_label&#34;:&#34;Zeile {row}, Spalte {column}&#34;},&#34;en&#34;:{&#34;restart_title&#34;:&#34;Server restarting&#34;,&#34;reassurance&#34;:&#34;Do not worry (:\nWe are coming back in few seconds&#34;,&#34;reconnecting&#34;:&#34;Reconnecting automatically…&#34;,&#34;ready&#34;:&#34;Server is ready. Opening page…&#34;,&#34;ready_playing&#34;:&#34;Server is ready! Keep playing or return to the website.&#34;,&#34;noscript&#34;:&#34;Enable JavaScript to reconnect automatically, or use the link below.&#34;,&#34;reload&#34;:&#34;Reload the page&#34;,&#34;blocked_title&#34;:&#34;Hostname blacklisted&#34;,&#34;blocked_message&#34;:&#34;Make sure requested domain points to current server.&#34;,&#34;tls_hostname_title&#34;:&#34;Hostname required&#34;,&#34;tls_hostname_message&#34;:&#34;Secure request without hostname not allowed.&#34;,&#34;body_limit_title&#34;:&#34;Request Entity Too Large&#34;,&#34;body_limit_message&#34;:&#34;Your upload or form is larger than this website allows. The maximum total size is 200 MiB. Use smaller files or send fewer files at a time, then try again.&#34;,&#34;input_limit_message&#34;:&#34;This form contains too many fields, files or nested values. Send fewer items or simplify the form, then try again.&#34;,&#34;game_title&#34;:&#34;Tic-tac-toe&#34;,&#34;game_rules&#34;:&#34;12×12 · Five in a row, column or diagonal wins.&#34;,&#34;restart_game&#34;:&#34;Start fresh&#34;,&#34;language_label&#34;:&#34;Language&#34;,&#34;your_turn&#34;:&#34;Your turn · X&#34;,&#34;computer_turn&#34;:&#34;Computer’s turn · O&#34;,&#34;win&#34;:&#34;You win!&#34;,&#34;lose&#34;:&#34;Computer wins!&#34;,&#34;draw&#34;:&#34;It’s a draw!&#34;,&#34;play_again&#34;:&#34;Play again&#34;,&#34;continue&#34;:&#34;Return to website&#34;,&#34;cell_label&#34;:&#34;Row {row}, column {column}&#34;},&#34;es&#34;:{&#34;restart_title&#34;:&#34;El servidor se está reiniciando&#34;,&#34;reassurance&#34;:&#34;No te preocupes (:\nVolveremos en unos segundos&#34;,&#34;reconnecting&#34;:&#34;Reconectando automáticamente…&#34;,&#34;ready&#34;:&#34;El servidor está listo. Abriendo la página…&#34;,&#34;ready_playing&#34;:&#34;¡El servidor está listo! Sigue jugando o vuelve al sitio.&#34;,&#34;noscript&#34;:&#34;Activa JavaScript para reconectar automáticamente o usa el enlace de abajo.&#34;,&#34;reload&#34;:&#34;Recargar la página&#34;,&#34;blocked_title&#34;:&#34;Dominio bloqueado&#34;,&#34;blocked_message&#34;:&#34;Asegúrate de que el dominio solicitado apunte a este servidor.&#34;,&#34;tls_hostname_title&#34;:&#34;Se requiere un nombre de dominio&#34;,&#34;tls_hostname_message&#34;:&#34;No se permite una solicitud segura sin nombre de dominio.&#34;,&#34;body_limit_title&#34;:&#34;Solicitud demasiado grande&#34;,&#34;body_limit_message&#34;:&#34;Los archivos o el formulario superan el tamaño permitido por este sitio. El tamaño total máximo es de 200 MiB. Usa archivos más pequeños o envía menos archivos a la vez e inténtalo de nuevo.&#34;,&#34;input_limit_message&#34;:&#34;Este formulario contiene demasiados campos, archivos o valores anidados. Envía menos elementos o simplifica el formulario e inténtalo de nuevo.&#34;,&#34;game_title&#34;:&#34;Tres en raya&#34;,&#34;game_rules&#34;:&#34;12×12 · Gana con cinco en horizontal, vertical o diagonal.&#34;,&#34;restart_game&#34;:&#34;Empezar de nuevo&#34;,&#34;language_label&#34;:&#34;Idioma&#34;,&#34;your_turn&#34;:&#34;Tu turno · X&#34;,&#34;computer_turn&#34;:&#34;Turno del ordenador · O&#34;,&#34;win&#34;:&#34;¡Has ganado!&#34;,&#34;lose&#34;:&#34;¡Ha ganado el ordenador!&#34;,&#34;draw&#34;:&#34;¡Empate!&#34;,&#34;play_again&#34;:&#34;Jugar de nuevo&#34;,&#34;continue&#34;:&#34;Volver al sitio&#34;,&#34;cell_label&#34;:&#34;Fila {row}, columna {column}&#34;},&#34;it&#34;:{&#34;restart_title&#34;:&#34;Riavvio del server in corso&#34;,&#34;reassurance&#34;:&#34;Non preoccuparti (:\nTorniamo tra pochi secondi&#34;,&#34;reconnecting&#34;:&#34;Riconnessione automatica…&#34;,&#34;ready&#34;:&#34;Il server è pronto. Apertura della pagina…&#34;,&#34;ready_playing&#34;:&#34;Il server è pronto! Continua a giocare o torna al sito.&#34;,&#34;noscript&#34;:&#34;Abilita JavaScript per riconnetterti automaticamente oppure usa il link qui sotto.&#34;,&#34;reload&#34;:&#34;Ricarica la pagina&#34;,&#34;blocked_title&#34;:&#34;Dominio bloccato&#34;,&#34;blocked_message&#34;:&#34;Assicurati che il dominio richiesto punti a questo server.&#34;,&#34;tls_hostname_title&#34;:&#34;Nome di dominio richiesto&#34;,&#34;tls_hostname_message&#34;:&#34;Una richiesta sicura senza nome di dominio non è consentita.&#34;,&#34;body_limit_title&#34;:&#34;Richiesta troppo grande&#34;,&#34;body_limit_message&#34;:&#34;I file caricati o il modulo superano le dimensioni consentite da questo sito. La dimensione totale massima è 200 MiB. Usa file più piccoli o invia meno file alla volta, poi riprova.&#34;,&#34;input_limit_message&#34;:&#34;Questo modulo contiene troppi campi, file o valori annidati. Invia meno elementi o semplifica il modulo, poi riprova.&#34;,&#34;game_title&#34;:&#34;Tris&#34;,&#34;game_rules&#34;:&#34;12×12 · Vinci con cinque simboli in orizzontale, verticale o diagonale.&#34;,&#34;restart_game&#34;:&#34;Ricomincia&#34;,&#34;language_label&#34;:&#34;Lingua&#34;,&#34;your_turn&#34;:&#34;Tocca a te · X&#34;,&#34;computer_turn&#34;:&#34;Tocca al computer · O&#34;,&#34;win&#34;:&#34;Hai vinto!&#34;,&#34;lose&#34;:&#34;Il computer ha vinto!&#34;,&#34;draw&#34;:&#34;Pareggio!&#34;,&#34;play_again&#34;:&#34;Gioca ancora&#34;,&#34;continue&#34;:&#34;Torna al sito&#34;,&#34;cell_label&#34;:&#34;Riga {row}, colonna {column}&#34;},&#34;ja&#34;:{&#34;restart_title&#34;:&#34;サーバーを再起動しています&#34;,&#34;reassurance&#34;:&#34;心配しないでください (:\n数秒で戻ります&#34;,&#34;reconnecting&#34;:&#34;自動的に再接続しています…&#34;,&#34;ready&#34;:&#34;サーバーの準備ができました。ページを開いています…&#34;,&#34;ready_playing&#34;:&#34;サーバーの準備ができました！ゲームを続けるか、サイトに戻れます。&#34;,&#34;noscript&#34;:&#34;自動的に再接続するにはJavaScriptを有効にするか、下のリンクを使ってください。&#34;,&#34;reload&#34;:&#34;ページを再読み込み&#34;,&#34;blocked_title&#34;:&#34;ドメインはブラックリストに登録されています&#34;,&#34;blocked_message&#34;:&#34;アクセスしたドメインがこのサーバーを参照していることを確認してください。&#34;,&#34;tls_hostname_title&#34;:&#34;ドメイン名が必要です&#34;,&#34;tls_hostname_message&#34;:&#34;ドメイン名のないセキュアなリクエストは許可されていません。&#34;,&#34;body_limit_title&#34;:&#34;リクエストのサイズが大きすぎます&#34;,&#34;body_limit_message&#34;:&#34;アップロードするファイルやフォームが、このサイトで許可されているサイズを超えています。合計サイズの上限は 200 MiB です。ファイルを小さくするか、一度に送信するファイル数を減らして、もう一度お試しください。&#34;,&#34;input_limit_message&#34;:&#34;このフォームには、項目、ファイル、または入れ子になった値が多すぎます。送信する項目を減らすか、フォームを簡単にして、もう一度お試しください。&#34;,&#34;game_title&#34;:&#34;五目並べ&#34;,&#34;game_rules&#34;:&#34;12×12 · 縦・横・斜めに5つ並べると勝ちです。&#34;,&#34;restart_game&#34;:&#34;最初から始める&#34;,&#34;language_label&#34;:&#34;言語&#34;,&#34;your_turn&#34;:&#34;あなたの番 · X&#34;,&#34;computer_turn&#34;:&#34;コンピューターの番 · O&#34;,&#34;win&#34;:&#34;あなたの勝ちです！&#34;,&#34;lose&#34;:&#34;コンピューターの勝ちです！&#34;,&#34;draw&#34;:&#34;引き分けです！&#34;,&#34;play_again&#34;:&#34;もう一度遊ぶ&#34;,&#34;continue&#34;:&#34;サイトに戻る&#34;,&#34;cell_label&#34;:&#34;{row}行、{column}列&#34;},&#34;kk-KZ&#34;:{&#34;restart_title&#34;:&#34;Сервер қайта іске қосылуда&#34;,&#34;reassurance&#34;:&#34;Уайымдамаңыз (:\nБірнеше секундтан кейін қайта ораламыз&#34;,&#34;reconnecting&#34;:&#34;Автоматты түрде қайта қосылуда…&#34;,&#34;ready&#34;:&#34;Сервер дайын. Бет ашылуда…&#34;,&#34;ready_playing&#34;:&#34;Сервер дайын! Ойынды жалғастырыңыз немесе сайтқа оралыңыз.&#34;,&#34;noscript&#34;:&#34;Автоматты түрде қосылу үшін JavaScript-ті қосыңыз немесе төмендегі сілтемені пайдаланыңыз.&#34;,&#34;reload&#34;:&#34;Бетті жаңарту&#34;,&#34;blocked_title&#34;:&#34;Домен қара тізімде&#34;,&#34;blocked_message&#34;:&#34;Сұралған доменнің осы серверге бағытталғанына көз жеткізіңіз.&#34;,&#34;tls_hostname_title&#34;:&#34;Домен атауы қажет&#34;,&#34;tls_hostname_message&#34;:&#34;Домен атауынсыз қауіпсіз сұрауға рұқсат етілмейді.&#34;,&#34;body_limit_title&#34;:&#34;Сұрау көлемі тым үлкен&#34;,&#34;body_limit_message&#34;:&#34;Жүктелетін файлдардың немесе пішіннің көлемі осы сайт рұқсат еткен шектен асты. Ең үлкен жалпы көлем — 200 MiB. Кішірек файлдарды таңдаңыз немесе бір уақытта азырақ файл жіберіп, қайталап көріңіз.&#34;,&#34;input_limit_message&#34;:&#34;Бұл пішінде өрістер, файлдар немесе ішкі мәндер тым көп. Азырақ элемент жіберіңіз немесе пішінді жеңілдетіп, қайталап көріңіз.&#34;,&#34;game_title&#34;:&#34;Крестиктер-нөлдіктер&#34;,&#34;game_rules&#34;:&#34;12×12 · Көлденең, тігінен немесе диагональ бойынша бес белгімен жеңіңіз.&#34;,&#34;restart_game&#34;:&#34;Қайта бастау&#34;,&#34;language_label&#34;:&#34;Тіл&#34;,&#34;your_turn&#34;:&#34;Сіздің кезегіңіз · X&#34;,&#34;computer_turn&#34;:&#34;Компьютердің кезегі · O&#34;,&#34;win&#34;:&#34;Сіз жеңдіңіз!&#34;,&#34;lose&#34;:&#34;Компьютер жеңді!&#34;,&#34;draw&#34;:&#34;Тең ойын!&#34;,&#34;play_again&#34;:&#34;Қайта ойнау&#34;,&#34;continue&#34;:&#34;Сайтқа оралу&#34;,&#34;cell_label&#34;:&#34;{row}-жол, {column}-баған&#34;},&#34;pt&#34;:{&#34;restart_title&#34;:&#34;O servidor está a reiniciar&#34;,&#34;reassurance&#34;:&#34;Não se preocupe (:\nVoltamos dentro de alguns segundos&#34;,&#34;reconnecting&#34;:&#34;A restabelecer a ligação automaticamente…&#34;,&#34;ready&#34;:&#34;O servidor está pronto. A abrir a página…&#34;,&#34;ready_playing&#34;:&#34;O servidor está pronto! Continue a jogar ou volte ao site.&#34;,&#34;noscript&#34;:&#34;Ative o JavaScript para restabelecer a ligação automaticamente ou use a ligação abaixo.&#34;,&#34;reload&#34;:&#34;Recarregar a página&#34;,&#34;blocked_title&#34;:&#34;Domínio bloqueado&#34;,&#34;blocked_message&#34;:&#34;Certifique-se de que o domínio pedido aponta para este servidor.&#34;,&#34;tls_hostname_title&#34;:&#34;É necessário um nome de domínio&#34;,&#34;tls_hostname_message&#34;:&#34;Não é permitido um pedido seguro sem nome de domínio.&#34;,&#34;body_limit_title&#34;:&#34;Pedido demasiado grande&#34;,&#34;body_limit_message&#34;:&#34;Os ficheiros ou o formulário excedem o tamanho permitido por este site. O tamanho total máximo é 200 MiB. Use ficheiros mais pequenos ou envie menos ficheiros de cada vez e tente novamente.&#34;,&#34;input_limit_message&#34;:&#34;Este formulário contém demasiados campos, ficheiros ou valores aninhados. Envie menos elementos ou simplifique o formulário e tente novamente.&#34;,&#34;game_title&#34;:&#34;Jogo do galo&#34;,&#34;game_rules&#34;:&#34;12×12 · Ganhe com cinco na horizontal, vertical ou diagonal.&#34;,&#34;restart_game&#34;:&#34;Começar de novo&#34;,&#34;language_label&#34;:&#34;Idioma&#34;,&#34;your_turn&#34;:&#34;A sua vez · X&#34;,&#34;computer_turn&#34;:&#34;A vez do computador · O&#34;,&#34;win&#34;:&#34;Ganhou!&#34;,&#34;lose&#34;:&#34;O computador ganhou!&#34;,&#34;draw&#34;:&#34;Empate!&#34;,&#34;play_again&#34;:&#34;Jogar novamente&#34;,&#34;continue&#34;:&#34;Voltar ao site&#34;,&#34;cell_label&#34;:&#34;Linha {row}, coluna {column}&#34;},&#34;ru&#34;:{&#34;restart_title&#34;:&#34;Сервер перезапускается&#34;,&#34;reassurance&#34;:&#34;Не волнуйтесь (:\nМы вернёмся через несколько секунд&#34;,&#34;reconnecting&#34;:&#34;Подключаемся автоматически…&#34;,&#34;ready&#34;:&#34;Сервер готов. Открываем страницу…&#34;,&#34;ready_playing&#34;:&#34;Сервер готов! Продолжайте играть или вернитесь на сайт.&#34;,&#34;noscript&#34;:&#34;Включите JavaScript для автоматического подключения или воспользуйтесь ссылкой ниже.&#34;,&#34;reload&#34;:&#34;Обновить страницу&#34;,&#34;blocked_title&#34;:&#34;Домен в чёрном списке&#34;,&#34;blocked_message&#34;:&#34;Убедитесь, что запрошенный домен указывает на текущий сервер.&#34;,&#34;tls_hostname_title&#34;:&#34;Требуется имя домена&#34;,&#34;tls_hostname_message&#34;:&#34;Защищённый запрос без имени домена не разрешён.&#34;,&#34;body_limit_title&#34;:&#34;Слишком большой объём запроса&#34;,&#34;body_limit_message&#34;:&#34;Размер загружаемых файлов или формы превышает допустимый для этого сайта. Максимальный общий размер — 200 MiB. Уменьшите файлы или отправляйте их меньшими группами и попробуйте снова.&#34;,&#34;input_limit_message&#34;:&#34;В этой форме слишком много полей, файлов или вложенных значений. Отправьте меньше элементов или упростите форму и попробуйте снова.&#34;,&#34;game_title&#34;:&#34;Крестики-нолики&#34;,&#34;game_rules&#34;:&#34;Поле 12×12 · Пять в ряд по горизонтали, вертикали или диагонали — победа.&#34;,&#34;restart_game&#34;:&#34;Начать заново&#34;,&#34;language_label&#34;:&#34;Язык&#34;,&#34;your_turn&#34;:&#34;Ваш ход · X&#34;,&#34;computer_turn&#34;:&#34;Ход компьютера · O&#34;,&#34;win&#34;:&#34;Вы выиграли!&#34;,&#34;lose&#34;:&#34;Компьютер выиграл!&#34;,&#34;draw&#34;:&#34;Ничья!&#34;,&#34;play_again&#34;:&#34;Играть снова&#34;,&#34;continue&#34;:&#34;Вернуться на сайт&#34;,&#34;cell_label&#34;:&#34;Строка {row}, столбец {column}&#34;},&#34;tr&#34;:{&#34;restart_title&#34;:&#34;Sunucu yeniden başlatılıyor&#34;,&#34;reassurance&#34;:&#34;Endişelenmeyin (:\nBirkaç saniye içinde geri döneceğiz&#34;,&#34;reconnecting&#34;:&#34;Otomatik olarak yeniden bağlanılıyor…&#34;,&#34;ready&#34;:&#34;Sunucu hazır. Sayfa açılıyor…&#34;,&#34;ready_playing&#34;:&#34;Sunucu hazır! Oynamaya devam edin veya siteye dönün.&#34;,&#34;noscript&#34;:&#34;Otomatik bağlanmak için JavaScript’i etkinleştirin veya aşağıdaki bağlantıyı kullanın.&#34;,&#34;reload&#34;:&#34;Sayfayı yenile&#34;,&#34;blocked_title&#34;:&#34;Alan adı kara listede&#34;,&#34;blocked_message&#34;:&#34;İstenen alan adının bu sunucuya yönlendirildiğinden emin olun.&#34;,&#34;tls_hostname_title&#34;:&#34;Alan adı gerekli&#34;,&#34;tls_hostname_message&#34;:&#34;Alan adı olmadan güvenli isteğe izin verilmez.&#34;,&#34;body_limit_title&#34;:&#34;İstek boyutu çok büyük&#34;,&#34;body_limit_message&#34;:&#34;Yüklediğiniz dosyalar veya form bu sitenin izin verdiği boyutu aşıyor. İzin verilen toplam boyut en fazla 200 MiB. Daha küçük dosyalar kullanın veya aynı anda daha az dosya göndererek yeniden deneyin.&#34;,&#34;input_limit_message&#34;:&#34;Bu formda çok fazla alan, dosya veya iç içe değer var. Daha az öğe gönderin veya formu sadeleştirip yeniden deneyin.&#34;,&#34;game_title&#34;:&#34;XOX&#34;,&#34;game_rules&#34;:&#34;12×12 · Yatay, dikey veya çapraz beş işaretle kazanın.&#34;,&#34;restart_game&#34;:&#34;Baştan başla&#34;,&#34;language_label&#34;:&#34;Dil&#34;,&#34;your_turn&#34;:&#34;Sıra sizde · X&#34;,&#34;computer_turn&#34;:&#34;Bilgisayarın sırası · O&#34;,&#34;win&#34;:&#34;Kazandınız!&#34;,&#34;lose&#34;:&#34;Bilgisayar kazandı!&#34;,&#34;draw&#34;:&#34;Berabere!&#34;,&#34;play_again&#34;:&#34;Tekrar oyna&#34;,&#34;continue&#34;:&#34;Siteye dön&#34;,&#34;cell_label&#34;:&#34;Satır {row}, sütun {column}&#34;},&#34;uk&#34;:{&#34;restart_title&#34;:&#34;Сервер перезапускається&#34;,&#34;reassurance&#34;:&#34;Не хвилюйтеся (:\nМи повернемося за кілька секунд&#34;,&#34;reconnecting&#34;:&#34;Підключаємося автоматично…&#34;,&#34;ready&#34;:&#34;Сервер готовий. Відкриваємо сторінку…&#34;,&#34;ready_playing&#34;:&#34;Сервер готовий! Грайте далі або поверніться на сайт.&#34;,&#34;noscript&#34;:&#34;Увімкніть JavaScript для автоматичного підключення або скористайтеся посиланням нижче.&#34;,&#34;reload&#34;:&#34;Оновити сторінку&#34;,&#34;blocked_title&#34;:&#34;Домен у чорному списку&#34;,&#34;blocked_message&#34;:&#34;Переконайтеся, що запитаний домен вказує на поточний сервер.&#34;,&#34;tls_hostname_title&#34;:&#34;Потрібне ім’я домену&#34;,&#34;tls_hostname_message&#34;:&#34;Захищений запит без імені домену не дозволено.&#34;,&#34;body_limit_title&#34;:&#34;Завеликий обсяг запиту&#34;,&#34;body_limit_message&#34;:&#34;Розмір завантажуваних файлів або форми перевищує дозволений для цього сайту. Максимальний загальний розмір — 200 MiB. Зменште файли або надсилайте їх меншими групами та спробуйте ще раз.&#34;,&#34;input_limit_message&#34;:&#34;У цій формі забагато полів, файлів або вкладених значень. Надішліть менше елементів або спростіть форму та спробуйте ще раз.&#34;,&#34;game_title&#34;:&#34;Хрестики-нулики&#34;,&#34;game_rules&#34;:&#34;Поле 12×12 · П’ять у ряд по горизонталі, вертикалі або діагоналі — перемога.&#34;,&#34;restart_game&#34;:&#34;Почати заново&#34;,&#34;language_label&#34;:&#34;Мова&#34;,&#34;your_turn&#34;:&#34;Ваш хід · X&#34;,&#34;computer_turn&#34;:&#34;Хід комп’ютера · O&#34;,&#34;win&#34;:&#34;Ви виграли!&#34;,&#34;lose&#34;:&#34;Комп’ютер виграв!&#34;,&#34;draw&#34;:&#34;Нічия!&#34;,&#34;play_again&#34;:&#34;Грати знову&#34;,&#34;continue&#34;:&#34;Повернутися на сайт&#34;,&#34;cell_label&#34;:&#34;Рядок {row}, стовпець {column}&#34;}}"><style>[hidden]{display:none!important}
.language-picker{display:flex;align-items:center;justify-content:flex-end;flex-wrap:wrap;gap:8px;margin:0 0 24px;font-size:13px;grid-column:1/-1}
.language-picker select{max-width:100%;font:inherit;color:inherit;background:transparent;border:1px solid #718096;border-radius:8px;padding:7px 10px;cursor:pointer}
.language-picker select:focus-visible{outline:2px solid #70d9b3;outline-offset:3px}
</style><div id="status-language-picker" class="language-picker" hidden><label for="status-language" data-i18n="language_label">Language</label><select id="status-language"><option value="en" selected>English</option><option value="az">Azərbaycanca</option><option value="tr">Türkçe</option><option value="ru">Русский</option><option value="uk">Українська</option><option value="de">Deutsch</option><option value="it">Italiano</option><option value="es">Español</option><option value="pt">Português</option><option value="kk-KZ">Қазақша (Қазақстан)</option><option value="ja">日本語</option></select></div><small>413</small><h1 data-i18n="body_limit_title">Request Entity Too Large</h1><p data-i18n="body_limit_message">Your upload or form is larger than this website allows. The maximum total size is 200 MiB. Use smaller files or send fewer files at a time, then try again.</p><script>(() => {
  "use strict";
  const page = document.getElementById("status-page");
  const catalog = JSON.parse(page.dataset.translations);
  const selector = document.getElementById("status-language");
  const messages = {...catalog[document.documentElement.lang]};
  window.pfStatusLanguage = {messages};

  function selectLanguage(language, remember) {
    if (!Object.prototype.hasOwnProperty.call(catalog, language)) return;
    Object.assign(messages, catalog[language]);
    document.documentElement.lang = language;
    selector.value = language;
    document.querySelectorAll("[data-i18n]").forEach(element => {
      const key = element.dataset.i18n;
      if (Object.prototype.hasOwnProperty.call(messages, key)) element.textContent = messages[key];
    });
    const titleKey = page.dataset.page === "restart" ? "restart_title" : document.querySelector("h1[data-i18n]").dataset.i18n;
    document.title = (page.dataset.page === "restart" ? "" : `${page.dataset.status} — `) + messages[titleKey];
    if (remember) {
      try { window.localStorage.setItem("pf-status-language", language); } catch (_) { /* Storage may be disabled. */ }
    }
    document.dispatchEvent(new Event("pf-status-language-change"));
  }

  let language = document.documentElement.lang;
  try {
    const saved = window.localStorage.getItem("pf-status-language");
    if (Object.prototype.hasOwnProperty.call(catalog, saved)) language = saved;
  } catch (_) { /* Keep the country-based default. */ }
  selectLanguage(language, false);
  selector.addEventListener("change", () => selectLanguage(selector.value, true));
  document.getElementById("status-language-picker").hidden = false;
})();
</script></body></html>